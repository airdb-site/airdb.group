---
import "../styles/global.css";
import { homeCopy, type HomeLocale } from "../config/home";
import { company, footerGroups, navigation } from "../config/site";

interface Props {
  title: string;
  description?: string;
  activePath?: string;
  noindex?: boolean;
  homeLocale?: HomeLocale;
}

const {
  homeLocale,
  noindex = false,
  title,
  description = "airdb Group builds AI infrastructure and enterprise delivery systems.",
  activePath = "/"
} = Astro.props;
const home = homeLocale ? homeCopy[homeLocale] : undefined;
const homePath = homeLocale === "en" ? "/en/" : "/";
const homeNav = home ? ["/about", "#business", "#method", "#cooperation"].map((href, i) => ({ href, label: home.nav[i] })) : [];
---

<!doctype html>
<html lang={homeLocale === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {home && <>
      <link rel="alternate" hreflang="zh-CN" href="https://airdb.group/" />
      <link rel="alternate" hreflang="en" href="https://airdb.group/en/" />
      <link rel="alternate" hreflang="x-default" href="https://airdb.group/" />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:type" content="website" />
      <meta property="og:url" content={`https://airdb.group${homePath}`} />
      <meta property="og:locale" content={homeLocale === "zh" ? "zh_CN" : "en_US"} />
      <meta property="og:image" content="https://airdb.group/images/group-home/hero.webp" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
    </>}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Source+Serif+4:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={[home && "group-home", homeLocale && `home-${homeLocale}`]}>
    <a class="skip-link" href="#main-content">{home?.skip ?? "Skip to content"}</a>
    <header class="site-header">
      <div class="shell nav-shell" data-mobile-nav-root>
        <div class="nav-topline">
          <a class="brand" href={home ? homePath : "/"}>
            <span class="brand-mark">{company.shortName}</span>
            <span class="brand-group">Group</span>
          </a>
          <button
            class="nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="primary-nav"
            aria-label={home?.menu ?? "Toggle navigation"}
            data-mobile-nav-toggle
          >
            <span></span>
            <span></span>
          </button>
        </div>
        <nav class="site-nav" id="primary-nav" aria-label={home?.primary ?? "Primary"}>
          {
            (home ? homeNav : navigation).map((item) => (
              <a
                href={item.href}
                aria-current={activePath === item.href ? "page" : undefined}
                class:list={[
                  "nav-link",
                  activePath === item.href && "is-active"
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        {home && <div class="home-header-actions"><nav class="home-language" aria-label={home.language}><a href="/" lang="zh-CN" hreflang="zh-CN" aria-current={homeLocale === "zh" ? "page" : undefined}>中文</a><span aria-hidden="true">/</span><a href="/en/" lang="en" hreflang="en" aria-current={homeLocale === "en" ? "page" : undefined}>EN</a></nav><a class="home-header-contact" href="/contact">{home.contact}</a></div>}
      </div>
    </header>
    <main id="main-content" tabindex={home ? -1 : undefined}>
      <slot />
    </main>
    {home ? <footer class="home-footer home-shell"><div class="home-footer-top"><a class="home-footer-brand" href={homePath}>AIRDB <span>Group</span></a><p>{home.warmth}</p><a href={`mailto:${company.email}`}>{company.email}</a></div><nav aria-label={homeLocale === "zh" ? "公司与资源" : "Company and resources"}>{["/about","/contact","/solutions","/services","/engineering"].map((href,i)=><a href={href}>{home.footer[i]}</a>)}</nav><div class="home-footer-bottom"><span>© 2026 Airdb, airdb.group</span><p>{home.footerNote}</p></div></footer> : (
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div class="footer-brand">
          <p class="eyebrow">AIRDB Group</p>
          <h2>Corporate presence with technical depth.</h2>
          <p class="footer-copy">
            Designed for enterprise customers, partners, technical candidates,
            and diligence reviewers.
          </p>
          <a class="footer-mail" href={`mailto:${company.email}`}>{company.email}</a>
        </div>
        <div class="footer-columns">
          {
            footerGroups.map((group) => (
              <section>
                <h3>{group.title}</h3>
                <div class="footer-links">
                  {group.links.map((item) => <a href={item.href}>{item.label}</a>)}
                </div>
              </section>
            ))
          }
        </div>
      </div>
    </footer>
    )}
    <script is:inline>
      const navRoot = document.querySelector("[data-mobile-nav-root]");
      const navToggle = document.querySelector("[data-mobile-nav-toggle]");

      if (navRoot instanceof HTMLElement && navToggle instanceof HTMLButtonElement) {
        const narrow = window.matchMedia('(max-width: 760px)');
        const closeNav = () => {
          navRoot.dataset.mobileNavOpen = 'false';
          navToggle.setAttribute('aria-expanded', 'false');
        };
        const syncNav = () => closeNav();

        syncNav();

        navToggle.addEventListener("click", () => {
          const isOpen = navRoot.dataset.mobileNavOpen === "true";
          navRoot.dataset.mobileNavOpen = isOpen ? "false" : "true";
          navToggle.setAttribute("aria-expanded", String(!isOpen));
        });

        if (document.body.classList.contains('group-home')) {
          document.querySelectorAll('.site-nav a').forEach((link) => link.addEventListener('click', closeNav));
        }
        narrow.addEventListener('change', syncNav);
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && navRoot.dataset.mobileNavOpen === 'true') {
            closeNav(); navToggle.focus();
          }
        });
      }
    </script>
  </body>
</html>
